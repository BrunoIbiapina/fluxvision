# FluxVision backend — copie para .env e ajuste
FLUXVISION_DB_URL=sqlite:///./data/fluxvision.db
FLUXVISION_UPLOAD_DIR=./data/uploads
FLUXVISION_HEATMAP_DIR=./data/heatmaps
FLUXVISION_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Modelo YOLO. O arquivo será baixado automaticamente pela Ultralytics
# na primeira execução. Opções: yolov8n.pt (rápido), yolov8s.pt (balanceado),
# yolov8m.pt (mais preciso, mais lento).
FLUXVISION_YOLO_MODEL=yolov8n.pt

# Intervalo de amostragem do vídeo (processa 1 frame a cada N).
# Mais alto = mais rápido / menos precisão.
FLUXVISION_FRAME_STRIDE=3

# Confiança mínima para considerar uma detecção válida (0-1).
FLUXVISION_CONF_THRESHOLD=0.35

# Se 1, ao iniciar a API, roda app.seed caso o banco esteja vazio.
FLUXVISION_SEED_ON_START=1

# Alerta: variação percentual (em relação ao baseline) que dispara alerta.
FLUXVISION_ANOMALY_THRESHOLD_PCT=40
